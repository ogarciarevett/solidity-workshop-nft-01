{
    "compilerOptions": {
        "rootDir": ".",
        "types": ["node", "mocha", "chai-as-promised"],
        "target": "es2020",
        "module": "Node16",
        "moduleResolution": "Node16",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "paths": {
            "@typechain/*": ["./typechain-types/*"],
            "@typechain": ["./typechain-types"]
        }
    }
}
